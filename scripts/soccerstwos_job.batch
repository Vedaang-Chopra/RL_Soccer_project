#!/bin/bash

# Soccer Twos RL Training Job Example Batch Script for PACE
# Author: Mili Das
# Date: 2026

# Replace gburdell3 with your GT username.
# Replace the training stage/profile with the actual run you want.

#SBATCH --job-name=soccerstwos
#SBATCH -N4 --ntasks-per-node=8
#SBATCH --mem-per-cpu=6G
#SBATCH -t12:00:00
#SBATCH --output=soccerstwos-%j.out
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=gburbell3@gatech.edu

source ~/miniconda3/etc/profile.d/conda.sh
conda activate soccerstwos

# Run the organized training entrypoint
python -m soccer_twos_project.training train --stage ppo_baseline --profile auto
